# ==============================================================================
# .gitignore para Calculadora de Áreas (AreaCalc)
# ==============================================================================

# Archivos de sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editores e IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Registros y volcados temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos temporales de pruebas
tmp/
temp/

# Notas y especificaciones internas
instrucciones_personalizadas/
